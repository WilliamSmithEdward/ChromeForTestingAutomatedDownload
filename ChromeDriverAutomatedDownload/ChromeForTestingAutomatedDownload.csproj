<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<Deterministic>false</Deterministic>
    <AssemblyVersion>1.1.3</AssemblyVersion>
    <PackageVersion>1.1.3</PackageVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageReadmeFile>nugetREADME.md</PackageReadmeFile>
  </PropertyGroup>
	
  <ItemGroup>
    <None Include="ChromeForTestingAutomatedDownload.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <InternalsVisibleTo Include="ChromeForTestingAutomatedDownload.Tests" />
    <None Include="nugetREADME.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
	
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Title>Chrome for Testing Automated Download</Title>
    <Authors>WilliamSmithE</Authors>
    <Copyright>William Smith (WilliamSmithE)</Copyright>
    <Description>Reads Google's Chrome for Testing JSON endpoints into C# models and looks up the download URLs of Chrome, chromedriver and chrome-headless-shell by version, milestone and platform. One helper downloads and extracts the chromedriver that matches the Chrome installed on the machine.</Description>
    <PackageProjectUrl>https://github.com/WilliamSmithEdward/ChromeForTestingAutomatedDownload</PackageProjectUrl>
    <RepositoryUrl>https://github.com/WilliamSmithEdward/ChromeForTestingAutomatedDownload</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<PackageTags>googlechromelabs;chromefortesting;chrome-for-testing;chrome;chromedriver;chromeheadlessshell;chrome-headless-shell;automation;download;selenium;webdriver</PackageTags>
	<PackageIcon>ChromeForTestingAutomatedDownload.png</PackageIcon>
  </PropertyGroup>

</Project>
